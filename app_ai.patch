+# --- AI Assistant API ---
+
+@app.route('/api/ai/chat', methods=['POST'])
+def ai_chat():
+    settings = Settings.query.first()
+    if not settings or not settings.gemini_api_key:
+        return jsonify({'error': 'Gemini API key is not configured in settings.'}), 400
+
+    genai.configure(api_key=settings.gemini_api_key)
+    model = genai.GenerativeModel('gemini-pro')
+
+    data = request.json
+    user_message = data.get('message', '')
+    context = data.get('context', '')
+
+    system_prompt = "You are an expert assistant built into a 3D Printing CRM. Answer questions, help with calculations, and provide advice on 3D printing and CRM usage. "
+    full_prompt = f"{system_prompt}\nContext (current page data):\n{context}\n\nUser: {user_message}"
+
+    try:
+        response = model.generate_content(full_prompt)
+        return jsonify({'response': response.text})
+    except Exception as e:
+        return jsonify({'error': str(e)}), 500
+
